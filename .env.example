# =================================================================
# 🚀 WEBVIBEZ PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =================================================================

# --- 1. Production Site URL ---
NEXT_PUBLIC_SITE_URL="https://webvibez.com"

# --- 2. Google Gemini AI (Content Generation & Suggestions) ---
GEMINI_API_KEY=""

# --- 3. Admin Security & Vercel Cron Secrets ---
CRON_SECRET="your_vercel_cron_secret_key_here"
BLOG_ADMIN_KEY="your_admin_secret_key_here"

# --- 4. Google Search Console API (Optional / Live Telemetry) ---
GSC_SITE_URL="https://webvibez.com"
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""
GSC_ACCESS_TOKEN=""

# --- 5. External Publishing & Distribution APIs ---

# DEV Community (DEV.to)
DEV_TO_API_KEY=""

# Hashnode Engineering Blog
HASHNODE_PUBLICATION_ID=""
HASHNODE_API_KEY=""

# Google Blogger API
BLOGGER_BLOG_ID=""
BLOGGER_API_KEY=""

# Notion Database Sync
NOTION_API_KEY=""
NOTION_DATABASE_ID=""
NOTION_API_VERSION="2022-06-28"

# Tumblr Blog
TUMBLR_BLOG_NAME=""
TUMBLR_API_KEY=""
TUMBLR_API_SECRET=""
TUMBLR_OAUTH_TOKEN=""
TUMBLR_OAUTH_SECRET=""

# Webflow & Squarespace (Optional Syndication)
WEBFLOW_API_TOKEN=""
SQUARESPACE_WEBSITE_ID=""
SQUARESPACE_API_KEY=""

# Medium Publication (Manual Import Workflow)
MEDIUM_PUBLICATION_URL="https://medium.com/@webvibez"

# --- 6. Telegram Instant Publishing Alerts ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_or_channel_id_here"

# --- 7. Turso Cloud Database (libSQL Edge DB) ---
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

