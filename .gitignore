# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js build outputs
/.next/
/out/
/build

# environment files (protect secrets)
.env*
!.env.example

# vercel
.vercel

# typescript & build info
*.tsbuildinfo
next-env.d.ts

# debug & error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# internal runtime cache & logs
src/lib/blog/.*.json
/scratch/

# OS & editor artifacts
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
